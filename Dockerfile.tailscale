FROM nousresearch/hermes-agent:latest

USER root

# Install Tailscale
RUN apt-get update && apt-get install -y curl && \
    curl -fsSL https://tailscale.com/install.sh | sh && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Fix for "no TailscaleVarRoot" error: Tailscale expects /var/lib/tailscale and /var/run/tailscale
RUN mkdir -p /var/lib/tailscale /var/run/tailscale && chmod 777 /var/lib/tailscale /var/run/tailscale

# The original entrypoint is /usr/bin/tini -g -- /opt/hermes/docker/entrypoint.sh
# We don't want to overwrite it, but we need tailscaled to run.
# We will use a wrapper script.
COPY docker/tailscale-wrapper.sh /usr/local/bin/tailscale-wrapper.sh
RUN chmod +x /usr/local/bin/tailscale-wrapper.sh

ENTRYPOINT ["/usr/local/bin/tailscale-wrapper.sh"]
